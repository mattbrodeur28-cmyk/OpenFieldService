{
  "name": "openfieldservice",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/setup-db.mjs && concurrently -n ui,api -c cyan,green \"vite\" \"wrangler dev --port 8787\"",
    "build": "vite build",
    "db:setup": "node scripts/setup-db.mjs",
    "test": "node --test tests/*.test.mjs",
    "db:migrate-uuids": "node scripts/setup-db.mjs --migrate-uuids",
    "previews:build": "node scripts/build-previews.mjs build",
    "previews:check": "node scripts/build-previews.mjs check",
    "previews:export": "node scripts/build-previews.mjs export",
    "start": "node --import tsx src/server/node.ts",
    "db:backup": "node scripts/backup-db.mjs",
    "builder:apply": "node scripts/apply-proposal.mjs",
    "users:reset-password": "node scripts/reset-user-password.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.8",
    "@hono/zod-openapi": "^0.18.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@salesforce-ux/design-system": "^2.264.3",
    "hono": "^4.6.0",
    "leaflet": "^1.9.4",
    "lucide-preact": "^0.575.0",
    "number-flow": "^0.6.2",
    "preact": "^10.25.0",
    "tsx": "^4.23.15",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@types/leaflet": "^1.9.23",
    "@types/node": "^24.19.2",
    "concurrently": "^9.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "packageManager": "pnpm@11.20.0"
}
